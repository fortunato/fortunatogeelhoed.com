{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noImportantStyles": "off"
			},
			"style": {
				"noDescendingSpecificity": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.nx",
			"!**/.angular",
			"!**/storybook-static",
			"!**/custom-elements.json",
			"!**/tests/visual/__snapshots__",
			"!**/test-results",
			"!**/playwright-report",
			"!**/*.generated.ts",
			"!**/packages/content/data.json",
			"!**/packages/content/home.json",
			"!**/packages/content/timeline.json",
			"!**/packages/content/frontend-frameworks.json",
			"!**/packages/content/backend-frameworks.json",
			"!**/*.html",
			"!**/*.svg"
		]
	},
	"overrides": [
		{
			"includes": ["**/styles/motion.css"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": ["packages/vue/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"useHookAtTopLevel": "off"
					},
					"style": {
						"useVueMultiWordComponentNames": "off"
					}
				}
			}
		}
	]
}
