{
	"name": "fortunatogeelhoed.com",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "Fortunato Geelhoed",
	"engines": {
		"node": ">=22",
		"bun": ">=1.3"
	},
	"scripts": {
		"dev:react": "nx run-many -t dev -p react api",
		"dev:vue": "nx run-many -t dev -p vue api",
		"dev:angular": "nx run-many -t dev -p angular api",
		"dev:all": "nx run-many -t dev -p react vue angular api --parallel=4",
		"build:css": "bun run scripts/build-css.ts",
		"build:content": "bun run scripts/build-content.ts",
		"build:og": "bun run scripts/build-og-images.ts",
		"build:icons": "bun run scripts/build-tech-icons.ts",
		"build": "bun run build:css && bun run build:icons && bun run build:og && bun run build:content && nx run-many -t build -p react vue angular api && bun run scripts/rewrite-asset-urls.ts",
		"build:react": "nx run react:build",
		"build:vue": "nx run vue:build",
		"build:angular": "nx run angular:build",
		"start": "NODE_ENV=production bun run packages/api/src/index.ts",
		"cem": "custom-elements-manifest analyze --config custom-elements-manifest.config.js",
		"prestorybook": "bun run build:css && bun run cem",
		"storybook": "storybook dev -p 6006 -c .storybook --no-open",
		"storybook:web-components": "storybook dev -p 6007 -c packages/shared/.storybook --no-open",
		"storybook:react": "storybook dev -p 6008 -c packages/react/.storybook --no-open",
		"storybook:vue": "storybook dev -p 6009 -c packages/vue/.storybook --no-open",
		"storybook:angular": "storybook dev -p 6010 -c packages/angular/.storybook --no-open",
		"prebuild-storybook": "bun run build:css && bun run cem",
		"build-storybook": "bun run scripts/build-storybook.ts",
		"serve-storybook": "PORT=6006 bun run scripts/serve-storybook-static.ts",
		"test": "bun run test:unit && bun run test:component && bun run test:a11y && bun run test:e2e && bun run test:visual && bun run test:storybook",
		"test:unit": "vitest run --project node --project dom",
		"test:coverage": "vitest run --project node --project dom --project browser-shared --coverage",
		"test:component": "vitest run --project browser-shared --project browser-react --project browser-vue --project browser-angular",
		"test:a11y": "bun run scripts/a11y-scan.ts",
		"test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
		"test:visual": "playwright test --config tests/visual/playwright.config.ts",
		"test:storybook": "vitest run --project \"storybook-*\"",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "nx run-many -t typecheck && bun run typecheck:tooling",
		"typecheck:react": "nx run react:typecheck",
		"typecheck:vue": "nx run vue:typecheck",
		"typecheck:angular": "nx run angular:typecheck",
		"typecheck:shared": "nx run shared:typecheck",
		"typecheck:api": "nx run api:typecheck",
		"typecheck:content": "nx run content:typecheck",
		"typecheck:tooling": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@angular/common": "^21.2.25",
		"@angular/compiler": "^21.2.25",
		"@angular/core": "^21.2.25",
		"@angular/forms": "^21.2.25",
		"@angular/platform-browser": "^21.2.25",
		"@angular/platform-server": "^21.2.25",
		"@angular/router": "^21.2.25",
		"@angular/ssr": "^21.2.26",
		"@grafana/faro-web-sdk": "^2.12.1",
		"@hono/standard-validator": "^0.4.0",
		"@hookform/resolvers": "^5.9.1",
		"@resvg/resvg-wasm": "^2.6.2",
		"@scalar/hono-api-reference": "^0.12.0",
		"@tanstack/react-query": "^5.104.2",
		"@tanstack/vue-form": "^1.33.5",
		"@tanstack/vue-query": "^5.104.2",
		"gray-matter": "^4.0.3",
		"hono": "^4.13.13",
		"hono-openapi": "^1.3.5",
		"hono-rate-limiter": "^0.5.4",
		"lenis": "^1.3.26",
		"lit": "^3.3.3",
		"markdown-it": "^14.3.2",
		"markdown-it-anchor": "^9.2.1",
		"pino": "^10.4.0",
		"pino-loki": "^3.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.90.0",
		"react-router": "^8.4.0",
		"satori": "^0.47.0",
		"vue": "^3.5.44",
		"vue-router": "^4.6.4",
		"zod": "^4.6.7",
		"zone.js": "^0.16.3"
	},
	"devDependencies": {
		"@analogjs/storybook-angular": "^2.8.1",
		"@analogjs/vite-plugin-angular": "^2.8.1",
		"@analogjs/vitest-angular": "^2.8.1",
		"@angular/animations": "^21.2.25",
		"@angular/build": "^21.2.26",
		"@angular/cdk": "^21.2.14",
		"@angular/compiler-cli": "^21.2.25",
		"@biomejs/biome": "^1.9.0",
		"@custom-elements-manifest/analyzer": "^0.11.0",
		"@grafana/faro-cli": "^0.13.0",
		"@grafana/faro-rollup-plugin": "^0.13.0",
		"@nx/js": "^23.0.0",
		"@nx/vite": "^23.0.0",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-vitest": "^10.6.2",
		"@storybook/angular": "^10.6.2",
		"@storybook/react-vite": "^10.6.2",
		"@storybook/vue3-vite": "^10.6.2",
		"@storybook/web-components-vite": "^10.6.2",
		"@testing-library/angular": "^19.3.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/vue": "^8.1.0",
		"@types/bun": "^1.3.14",
		"@types/markdown-it": "^14.1.2",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.3.0",
		"@vitejs/plugin-vue": "^5.2.0",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"axe-playwright": "^2.2.2",
		"custom-elements-manifest": "^1.0.0",
		"happy-dom": "^20.10.1",
		"lightningcss": "^1.32.0",
		"nx": "^23.0.0",
		"openapi-types": "^12.1.3",
		"simple-icons": "^16.22.0",
		"storybook": "^10.6.2",
		"typescript": "^5.7.0",
		"vite": "^6.0.0",
		"vite-ssg": "^0.24.0",
		"vitest": "^4.1.11",
		"vue-tsc": "^3.3.3"
	},
	"customElements": "packages/shared/custom-elements.json"
}
