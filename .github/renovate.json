{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:best-practices", ":semanticCommits"],
	"timezone": "Europe/Amsterdam",
	"schedule": ["every weekend"],
	"labels": ["dependencies"],
	"platformAutomerge": true,
	"major": {
		"dependencyDashboardApproval": true
	},
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["every weekend"],
		"automerge": true
	},
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "minor and patch",
			"automerge": true
		},
		{
			"matchPackageNames": ["react", "react-dom", "vue", "@vue/**", "@angular/**"],
			"matchUpdateTypes": ["major"],
			"groupName": "framework majors"
		},
		{
			"description": "TypeScript 7 drops the JavaScript compiler API that nx, the Vite plugins and the Angular compiler build on, and Angular 22 requires TypeScript 6.0. Raise the cap once the toolchain supports 7.",
			"matchPackageNames": ["typescript"],
			"allowedVersions": "<6.1"
		},
		{
			"matchManagers": ["github-actions"],
			"groupName": "github actions",
			"addLabels": ["ci"],
			"automerge": true
		}
	]
}
